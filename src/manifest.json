{
  "manifest_version": 3,
  "name": "mahalinkam",
  "version": "0.1.0",
  "description": "Save bookmarks to your self-hosted mahalinkam server.",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["activeTab", "tabs", "contextMenus", "storage", "notifications"],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "16": "src/assets/icon-16.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "commands": {
    "save_current_page": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Save the current page to mahalinkam"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mahalinkam@localhost",
      "strict_min_version": "121.0"
    }
  }
}
